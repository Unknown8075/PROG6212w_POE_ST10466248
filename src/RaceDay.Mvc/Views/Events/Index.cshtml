@model List<RaceDay.Mvc.Models.RaceEvent>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container py-4">
    <div class="d-flex justify-content-between
                align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Events</h1>
            <p class="text-muted">Your RaceDay events</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Event
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No events found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Type</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.EventName</td>
                                    <td>
                                        @item.EventDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>@item.Location</td>
                                    <td>@item.Distance km</td>
                                    <td>@item.EventType</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.EventID"
                                               class="btn btn-sm btn-outline-secondary">
                                                Edit
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.EventID"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this event?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
