@model RaceDay.Mvc.ViewModels.OrganiserDashboardViewModel

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Organiser Dashboard</h1>
            <p class="text-muted">
                Manage your RaceDay sporting events.
            </p>
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-primary">
                + Create Event
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Events</h6>
                    <h2 class="fw-bold">@Model.TotalEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Upcoming Events</h6>
                    <h2 class="fw-bold">@Model.UpcomingEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Next Event</h6>
                    <h5 class="fw-bold">
                        @(Model.NextEvent?.EventName ?? "None scheduled")
                    </h5>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">My Events</h5>
        </div>

        <div class="card-body">
            @if (!Model.Events.Any())
            {
                <div class="alert alert-info mb-0">
                    You have not created any events yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Location</th>
                                <th>Distance</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var raceEvent in Model.Events)
                            {
                                <tr>
                                    <td>@raceEvent.EventName</td>
                                    <td>
                                        @raceEvent.EventDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td>@raceEvent.Location</td>
                                    <td>@raceEvent.Distance km</td>
                                    <td>@raceEvent.EventType</td>
                                    <td>
                                        @if (raceEvent.EventDate > DateTime.UtcNow)
                                        {
                                            <span class="badge bg-success">
                                                Upcoming
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
