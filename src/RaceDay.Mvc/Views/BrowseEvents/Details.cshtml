@model RaceDay.Mvc.Models.RaceEvent
@using RaceDay.Mvc.Models

@{
    ViewData["Title"] = Model.EventName;
    var categories = ViewBag.Categories as List<RaceEventCategory>
                     ?? new List<RaceEventCategory>();
}

<div class="container py-4">
    <h1 class="fw-bold">@Model.EventName</h1>
    <p class="lead">@Model.Description</p>

    <div class="card mb-4">
        <div class="card-body">
            <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMM yyyy HH:mm")</p>
            <p><strong>Location:</strong> @Model.Location</p>
            <p><strong>Distance:</strong> @Model.Distance km</p>
            <p><strong>Type:</strong> @Model.EventType</p>
        </div>
    </div>

    <h3>Available Categories</h3>

    @foreach (var category in categories)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5>@category.CategoryName</h5>
                    <p class="mb-0">
                        Entry Fee: @category.EntryFee.ToString("C")
                        | Capacity: @category.MaximumParticipants
                    </p>
                </div>

                @if (Model.EventDate > DateTime.UtcNow)
                {
                    <form asp-controller="MyEnrolments"
                          asp-action="Enrol"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden"
                               name="eventCategoryId"
                               value="@category.EventCategoryID" />
                        <button type="submit" class="btn btn-success">
                            Enrol Now
                        </button>
                    </form>
                }
            </div>
        </div>
    }

    @if (!categories.Any())
    {
        <div class="alert alert-info">
            No categories are available for this event yet.
        </div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Events
    </a>
</div>
