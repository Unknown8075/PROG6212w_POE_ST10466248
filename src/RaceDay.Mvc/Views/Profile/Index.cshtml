@model RaceDay.Mvc.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">

    <h1 class="fw-bold">My Profile</h1>
    <p class="text-muted">
        Manage your RaceDay participant information.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- PROFILE PICTURE -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white">
            Profile Picture
        </div>

        <div class="card-body">
            <p class="text-muted">
                Upload a JPG, PNG or WEBP image.
                Maximum file size: 5 MB.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
            {
                <div class="mb-4 text-center">
                    <img src="@Url.Action("Picture", "Profile")"
                         alt="My profile picture"
                         class="rounded-circle border shadow-sm"
                         style="width:160px;height:160px;object-fit:cover;" />

                    <p class="text-success mt-2">
                        Profile picture configured.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    No profile picture uploaded yet.
                </div>
            }

            <form asp-controller="Profile"
                  asp-action="UploadPicture"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="profilePicture"
                           class="form-label">
                        Choose Profile Picture
                    </label>

                    <input type="file"
                           id="profilePicture"
                           name="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           required />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Upload Profile Picture
                </button>
            </form>
        </div>
    </div>

    <!-- PERSONAL INFORMATION -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white">
            Personal Information
        </div>

        <div class="card-body">
            <form asp-controller="Profile"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName"
                               class="form-label"></label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName"
                               class="form-label"></label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email Address</label>

                    <input value="@Model.Email"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Role</label>

                    <input value="@Model.Role"
                           class="form-control"
                           readonly />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Participant"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Dashboard
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
