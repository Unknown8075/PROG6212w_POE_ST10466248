@model List<RaceDay.Mvc.Models.ParticipantEnrolment>

@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container py-4">
    <h1 class="fw-bold">My Enrolments</h1>
    <p class="text-muted">Track your RaceDay registrations.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Enrolled On</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.Status == "Cancelled")
                            {
                                <span class="badge bg-danger">Cancelled</span>
                            }
                            else if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@item.Status</span>
                            }
                        </td>
                        <td>
                            @if (item.Status != "Cancelled")
                            {
                                <form asp-action="Cancel"
                                      asp-route-id="@item.EnrolmentID"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Cancel this enrolment?')">
                                        Cancel
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You have no enrolments yet.
        </div>
    }

    <a asp-action="Results" class="btn btn-primary">
        View My Race Results
    </a>
</div>
